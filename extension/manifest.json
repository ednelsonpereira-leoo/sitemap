{
  "manifest_version": 3,
  "name": "Sitemap Modular Dev",
  "version": "1.0.0",
  "description": "Troca o sitemap do site pelo bundle local do sitemap-modular e recarrega a página a cada build.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_title": "Sitemap Modular Dev (clique pra ligar/desligar)" }
}
